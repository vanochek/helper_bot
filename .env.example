AI_MODE=demo

# Локальные значения создаёт команда bootstrap. Ключ AI нужен только при реализации AI.
DATABASE_URL=postgresql+psycopg://helper:CHANGE_ME@127.0.0.1:55432/helper
POSTGRES_PASSWORD=CHANGE_ME
OPENAI_API_KEY=

# Точный адрес интерфейса; для размещения укажите HTTPS-домен.
APP_ORIGIN=http://127.0.0.1:8000

# Модель с поддержкой Responses API и структурированных ответов.
OPENAI_MODEL=

# Модель Audio Transcriptions, доступная вашему API-проекту.
OPENAI_STT_MODEL=
